      "promptText": "<div class=\"captcha-protect-box\">\n  <style>\n    .captcha-protect-box {\n      background: rgba(19, 28, 49, 0.9);\n      border: 1px solid rgba(59, 130, 246, 0.3);\n      padding: 20px;\n      border-radius: 16px;\n      max-width: 380px;\n      margin: 20px auto;\n      font-family: 'Inter', sans-serif;\n      text-align: center;\n      color: #fff;\n    }\n    .captcha-check-label {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n      background: rgba(0, 0, 0, 0.4);\n      padding: 12px 16px;\n      border-radius: 10px;\n      cursor: pointer;\n      border: 1px solid rgba(255, 255, 255, 0.1);\n      user-select: none;\n    }\n    .captcha-checkbox {\n      width: 22px;\n      height: 22px;\n      cursor: pointer;\n      accent-color: #3b82f6;\n    }\n    .download-link-ready {\n      margin-top: 15px;\n      display: none;\n      padding: 10px;\n      background: #22c55e;\n      color: white;\n      text-decoration: none;\n      border-radius: 8px;\n      font-weight: bold;\n    }\n  </style>\n\n  <p style=\"font-size: 14px; margin-bottom: 12px; color: #94a3b8;\">Human Verification Required</p>\n  <label class=\"captcha-check-label\">\n    <input type=\"checkbox\" class=\"captcha-checkbox\" onchange=\"verifyHuman(this)\" />\n    <span>I am not a robot (আমি রোবট নই)</span>\n  </label>\n  <a href=\"#\" id=\"verifiedDownloadBtn\" class=\"download-link-ready\">✅ লিংক আনলক হয়েছে - ডাউনলোড করুন</a>\n\n  <script>\n    function verifyHuman(checkbox) {\n      if(checkbox.checked) {\n        setTimeout(() => {\n          document.getElementById('verifiedDownloadBtn').style.display = 'block';\n        }, 600);\n      }\n    }\n  </script>\n</div>",
